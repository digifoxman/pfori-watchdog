# Copy to .env on the VPS (in /var/www/project-xv/watchdog/.env). Not committed.

# Port the Express dashboard listens on (loopback only, proxied by Caddy).
WATCHDOG_APP_PORT=8091

# How old status.json's run_ts can be before the dashboard flags it as stale
# (checks haven't run recently - the timer/service may be stuck or down).
WATCHDOG_STALE_AFTER_MS=900000

# Per-curl timeout used by scripts/lib/common.sh, in seconds.
WATCHDOG_TIMEOUT=5

# Per-check-script wall-clock timeout enforced by run-checks.js, in milliseconds.
WATCHDOG_SCRIPT_TIMEOUT_MS=10000
