[Unit]
Description=pfori-watchdog dashboard app
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/project-xv/watchdog/app
ExecStart=/usr/bin/env node server.js
EnvironmentFile=-/var/www/project-xv/watchdog/.env
Restart=on-failure
RestartSec=5
# node lives under /root/.nvm (root's home dir isn't traversable by other
# users), so every Node process on this VPS runs as root - matches
# quiz.service and the pm2-run astro-frontend process.
User=root

[Install]
WantedBy=multi-user.target
